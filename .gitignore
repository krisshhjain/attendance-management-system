# Facial-recognition local data and generated artifacts. Keep source and test
# scripts visible to Git so they can be reviewed and intentionally tracked.
facial-recognition/diagnostic_output/
facial-recognition/embeddings/
facial-recognition/embeddings_backup_*/
facial-recognition/person*/
facial-recognition/benchmark_results*.json
facial-recognition/scoped_regeneration_report_*.json
facial-recognition/vggface2_open_set_results.json

# Keep additional downloaded model assets out of Git; the runtime models and
# license below are explicitly tracked through the exceptions.
facial-recognition/models/*
!facial-recognition/models/mini_fas_best_model_quantized.onnx
!facial-recognition/models/mini_fas_detector_quantized.onnx
!facial-recognition/models/LICENSE

# Locally transferred language model weights
