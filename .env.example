DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=your_local_password
DB_HOST=db
DB_PORT=5432
# Generate once per environment and keep the value out of source control.
DJANGO_SECRET_KEY=
FACE_SERVICE_URL=http://127.0.0.1:8001
# Use the same private token in both services when the FR API is reachable
# outside loopback. Leave blank for loopback-only local use.
FACE_SERVICE_TOKEN=

# Local-only HR Copilot LLM. The model is imported into the local Ollama store.
HR_COPILOT_LLM_PROVIDER=local_ollama_qwen
HR_COPILOT_LLM_URL=http://127.0.0.1:11434
HR_COPILOT_LLM_MODEL=qwen3-8b-q4km-local
HR_COPILOT_LLM_TIMEOUT_SECONDS=120
HR_COPILOT_LLM_TEMPERATURE=0
HR_COPILOT_LLM_NUM_CTX=8192

# Geofence Configuration
GEOFENCE_LATITUDE=28.5300409164614
GEOFENCE_LONGITUDE=77.34955699676016
GEOFENCE_RADIUS_METERS=15000.0
GEOFENCE_MAX_ACCURACY_METERS=200.0
