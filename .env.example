DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=your_local_password
DB_HOST=db
DB_PORT=5432
DJANGO_SECRET_KEY=your_local_secret_key

# Local-only HR Copilot LLM. The model is imported into the local Ollama store.
HR_COPILOT_LLM_PROVIDER=local_ollama_qwen
HR_COPILOT_LLM_URL=http://127.0.0.1:11434
HR_COPILOT_LLM_MODEL=qwen3-8b-q4km-local
HR_COPILOT_LLM_TIMEOUT_SECONDS=120
HR_COPILOT_LLM_TEMPERATURE=0
