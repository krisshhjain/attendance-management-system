DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=your_local_password
# Generate once per environment and keep the value out of source control.
DJANGO_SECRET_KEY=
FACE_SERVICE_URL=http://127.0.0.1:8001
# Set the same private token in Django and facial-recognition for all API use.
FACE_SERVICE_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=5434

# Geofence Configuration
GEOFENCE_LATITUDE=28.5300409164614
GEOFENCE_LONGITUDE=77.34955699676016
GEOFENCE_RADIUS_METERS=150.0
GEOFENCE_MAX_ACCURACY_METERS=200.0

# Email configuration (leave blank/use console backend for local testing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=webmaster@localhost
